# Directory that holds the source datasets. Choose any location with about 2 GB free.
# `npm run data` fills it with:
#   mtg-jamendo-dataset/          clone of the MTG metadata repository
#   mtg-jamendo/acousticbrainz/   the 100 feature archives
# The pipeline reads this variable from the environment, or from this file when unset.
# Docker Compose reads it from this file as well.
MUSIC_MAP_DATA_DIR=/path/to/music-map-data
